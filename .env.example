# Copy to .env and replace every secret. Do not commit .env.
# scripts/init-env.sh generates a local file with random secrets.

NODE_ENV=development
PORT=3001
WEB_PORT=3000

POSTGRES_PASSWORD=change-me-postgres
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://madeye_app:change-me-app@localhost:5432/madeye
DATABASE_URL_MIGRATE=postgresql://madeye:change-me-postgres@localhost:5432/madeye

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://madeye:change-me-rabbit@localhost:5672
RABBITMQ_PASSWORD=change-me-rabbit

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=madeye
S3_SECRET_KEY=change-me-minio
S3_BUCKET=madeye
S3_REGION=us-east-1

JWT_ACCESS_SECRET=change-me-access-secret-must-be-long
JWT_REFRESH_SECRET=change-me-refresh-secret-must-be-long
WEBHOOK_ENCRYPTION_KEY=change-me-webhook-key-base64
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

INTELLIGENCE_BASE_URL=http://localhost:8000
API_INTERNAL_URL=http://127.0.0.1:3001
MAX_UPLOAD_BYTES=52428800
ENABLE_API_DOCS=true
RETENTION_SWEEP_ENABLED=false

# Leave empty unless a clamd daemon is running. Files are then marked SKIPPED_NOT_CONFIGURED.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Leave empty. Password-reset email delivery is not implemented.
SMTP_URL=
