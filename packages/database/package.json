{
  "name": "@madeye/database",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "generate": "pnpm -w db:generate",
    "build": "pnpm -w db:generate && tsc -p tsconfig.json",
    "seed": "tsx src/seed.ts",
    "migrate": "prisma migrate deploy",
    "test": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@madeye/shared-types": "workspace:*",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "dotenv": "18.0.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/pg": "8.23.1"
  }
}
